# ─────────────────────────────────────────────────────────────────────────────
# Freelancer-invoice Configuration d'environnement
# Copiez ce fichier en .env et renseignez les valeurs.
# .env ne doit JAMAIS être versionné (il est dans .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Environnement : local | production
APP_ENV=local

# Activer l'affichage des erreurs PHP (true uniquement en développement)
APP_DEBUG=true

# URL de base de l'application (sans slash final)
APP_URL=http://localhost:8080

# ─── Base de données ──────────────────────────────────────────────────────────
# Chemin absolu ou relatif (depuis la racine du projet) vers le fichier SQLite.
# Laisser vide pour utiliser le chemin par défaut : storage/invoices.sqlite
DB_PATH=

# ─── Licence ──────────────────────────────────────────────────────────────────
# Clé secrète utilisée pour signer les clés de licence (HMAC-SHA256).
# Peut aussi être stockée dans config/license.secret (la variable .env est
# prioritaire si renseignée). Ne jamais utiliser la valeur exemple en production.
LICENSE_SECRET=
